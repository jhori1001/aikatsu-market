# ---- PostgreSQL ----
POSTGRES_USER=aikatsu
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=aikatsu
POSTGRES_PORT=5432

# ---- クローラの名乗り（必ず自分の連絡先に書き換えてください）----
# 相手サイトから見て「誰が来ているか」が分かる状態にするのが礼儀であり、
# 万一負荷をかけた際に連絡が来るようにするための項目です。UAの偽装はしません。
CRAWLER_CONTACT=your-mail@example.com
CRAWLER_USER_AGENT=AikatsuMarketBot/0.1 (personal card catalog; contact: your-mail@example.com)

# ---- クロール挙動 ----
AIKATSU_INTERVAL_SEC=3.0
CRAWL_MAX_RETRIES=3
CRAWL_TIMEOUT_SEC=20

# ---- その他 ----
TZ=Asia/Tokyo
LOG_LEVEL=INFO
